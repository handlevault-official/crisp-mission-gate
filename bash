# 1. Initialize git
git init

# 2. Add all project files
git add .

# 3. Commit files
git commit -m "Initial commit: Crisp Mission Gate v1.0"

# 4. Set main branch
git branch -M main

# 5. Link to your GitHub repository (Palitan ang URL ng iyong repo)
git remote add origin https://github.com/YOUR_USERNAME/crisp-mission-gate.git

# 6. Push to GitHub
git push -u origin main
